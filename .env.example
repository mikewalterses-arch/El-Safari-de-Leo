# Firebase Web App config
# Estos valores son PÚBLICOS por diseño en Firebase Web — no son secretos.
# La seguridad real vive en firestore.rules y storage.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# UID del único usuario autorizado (Mikel, dueño del perfil de Leo).
# Las security rules permiten lectura/escritura solo si request.auth.uid coincide.
VITE_ADMIN_UID=
