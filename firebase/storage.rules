rules_version = '2';

// El Safari de Leo — multi-usuario.
// Cada familia escribe sus fotos bajo sightings/{uid}/... y solo el owner accede.

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /sightings/{uid}/{allPaths=**} {
      allow read, write: if isOwner(uid);
    }
  }
}
