rules_version = '2';

// El Safari de Leo — auth anónimo, sin login visible.
// Cualquier usuario autenticado (incluido el anónimo) puede leer y escribir
// cualquier documento. La URL no es pública, así que el acceso por descubrimiento
// es muy improbable. Si en algún momento se quiere endurecer, alternativas:
//  - Volver al modelo UID-fijo: `request.auth.uid == 'XXXXX'`
//  - Refactorizar a `users/{uid}/...` y `request.auth.uid == uid`

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
