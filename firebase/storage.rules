rules_version = '2';

// El Safari de Leo — auth anónimo. Cualquier usuario autenticado (incluido
// el anónimo) puede leer y escribir cualquier archivo del bucket.

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if isAuthenticated();
    }

    // TODO(post-cumple): si quieres endurecer, añadir límite de tamaño:
    //   match /sightings/{uid}/{file=**} {
    //     allow write: if isAuthenticated() && request.resource.size < 5 * 1024 * 1024;
    //   }
  }
}
