rules_version = '2';

// El Safari de Leo — single-owner.
// Solo el UID admin (Mikel) puede subir/descargar archivos.

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
          && request.auth.uid == 'Yhpn5HCgczcDvsnxXKylxzTe4sz2';
    }

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // TODO(fase-2): si fotos crecen mucho, añadir reglas por path con límite de tamaño:
    //   match /sightings/{sightingId}/{file=**} {
    //     allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024;
    //   }
  }
}
