rules_version = '2';

// El Safari de Leo — single-owner.
// Solo el UID admin (Mikel) puede leer/escribir cualquier doc.
// Las rules NO leen variables de entorno; el UID va hardcodeado.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.uid == 'Yhpn5HCgczcDvsnxXKylxzTe4sz2';
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // TODO(fase-2): si decidimos que el catálogo `animals/*` sea público en lectura
    // (para que la PWA cargue el catálogo antes del login), añadir aquí una regla
    // específica `match /animals/{id} { allow read: if true; }` por encima del wildcard.
  }
}
